{
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "date", "source_sha256", "stories"],
  "properties": {
    "contract": {"type": "string", "enum": ["sanctuary.gazette.draft.v1"]},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stories": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "connection", "headline", "paragraphs", "quotes"],
        "properties": {
          "kind": {"type": "string", "enum": ["lead", "support", "column"]},
          "connection": {"type": "string", "enum": ["standalone", "theme", "claimed_continuation"]},
          "headline": {"$ref": "#/$defs/headline"},
          "paragraphs": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/paragraph"}},
          "quotes": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/reference"}}
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["source", "sequence"],
      "properties": {
        "source": {"type": "string", "pattern": "^S[1-9][0-9]{0,2}$"},
        "sequence": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 63}, {"type": "null"}]}
      }
    },
    "headline": {
      "type": "object", "additionalProperties": false, "required": ["text", "claim_type", "references"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 120},
        "claim_type": {"type": "string", "enum": ["speech", "theme", "proposal", "imagination"]},
        "references": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/reference"}}
      }
    },
    "paragraph": {
      "type": "object", "additionalProperties": false, "required": ["text", "claim_type", "references"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 1000},
        "claim_type": {"type": "string", "enum": ["speech", "theme", "proposal", "imagination"]},
        "references": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/reference"}}
      }
    }
  }
}

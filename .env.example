# Documentation template only. PHP does not auto-load this file.
# Provision OPENAI_API_KEY through the private server environment, never Git or CLI arguments.
LITTLE_SPARKS_AI_ENABLED=0
# Optional V4 runner; no timer is installed. This also pauses scripted opportunities.
LITTLE_SPARKS_SIMULATION_ENABLED=0
# Separate scheduled adapter gates (strict 0/1). Templates are never installed.
LITTLE_SPARKS_SCHEDULER_ENABLED=0
LITTLE_SPARKS_SCHEDULER_ALLOW_PAID=0
LITTLE_SPARKS_SIMULATION_INTERVAL_MINUTES=15
# Real opportunities (0..1000) and considered turns/resident (0..100) per UTC day.
# Failed/quiet claims count. These do not raise AI HTTP or spending allowances.
LITTLE_SPARKS_ACTIVITY_DAILY_MAX=100
LITTLE_SPARKS_RESIDENT_DAILY_MAX=12
# Successful conversation cooldowns: seconds, resident 0..86400, pair 0..604800.
# Zero preserves existing behavior; gardening/quiet activity remains possible.
LITTLE_SPARKS_RESIDENT_CONVERSATION_COOLDOWN_SECONDS=0
LITTLE_SPARKS_PAIR_CONVERSATION_COOLDOWN_SECONDS=0
# Local replay only (0..3600 seconds); never creates an opportunity or AI call.
# Spaces different unplayed exchanges; each ID plays once per tab session.
LITTLE_SPARKS_MEADOW_REPLAY_COOLDOWN_SECONDS=60
LITTLE_SPARKS_AI_MODEL=gpt-6-luna
LITTLE_SPARKS_AI_MONTHLY_MICROUSD=1000000
LITTLE_SPARKS_AI_DAILY_REQUESTS=2
LITTLE_SPARKS_AI_MAX_OUTPUT_TOKENS=512
# Leave empty until the owner verifies current official pricing before approved staging activation.
LITTLE_SPARKS_AI_PRICING_CONFIRMED=
# Deterministic V5 memory bounds; these never add model requests or enable paid AI.
LITTLE_SPARKS_MEMORY_SELECT=4
LITTLE_SPARKS_MEMORY_CANDIDATES=32
LITTLE_SPARKS_MEMORY_RECENT_CONVERSATIONS=2
LITTLE_SPARKS_MEMORY_SHARED_CONTEXT=4
LITTLE_SPARKS_MEMORY_LEGACY_CONTEXT=3
LITTLE_SPARKS_MEMORY_PER_RESIDENT=128
LITTLE_SPARKS_MEMORY_FRIENDSHIP_HISTORY=32
LITTLE_SPARKS_MEMORY_HOPS=3
LITTLE_SPARKS_MEMORY_SHARES=1
LITTLE_SPARKS_MEMORY_STORIES=10000
LITTLE_SPARKS_MEMORY_CONTEXT_BYTES=8192
LITTLE_SPARKS_MEMORY_BACKFILL=500
# Independent V5 identity add-on (explicit CLI migration; does not enable AI).
# Public owner-authored text, default 2000 characters, integer 1–4000.
# LITTLE_SPARKS_PERSONALITY_MAX_CHARACTERS=2000
# Successful edits per resident/UTC day, default 6, integer 0–24; 0 pauses edits.
# LITTLE_SPARKS_IDENTITY_EDITS_PER_DAY=6
